meta {
  name: Create Salary
  type: http
  seq: 6
  tags: [
    Account
  ]
}

post {
  url: {{baseUrl}}/api/Salary
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Teste",
    "grossAmount": 2000.00,
    "netAmount": 1500.00,
    "startDate": "2025-01-01",
    "endDate": "2025-12-31"
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Account
    method: POST
    mode: json
    body:json: {
      {
        "name": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": "",
          "name": "",
          "createdAt": ""
        }
      '''
    }
  }
}

